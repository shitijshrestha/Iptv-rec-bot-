
import os
import asyncio
import datetime
import subprocess

from pyrogram import Client, filters
from pyrogram.types import Message
from pyrogram.errors import FloodWait


# ---------------- CONFIG (ENV) ----------------

API_ID = int(os.getenv("API_ID", "0"))
API_HASH = os.getenv("API_HASH", "")
BOT_TOKEN = os.getenv("BOT_TOKEN", "")

PERMANENT_ADMIN = int(os.getenv("PERMANENT_ADMIN", "0"))
DUMP_CHANNEL_ID = int(os.getenv("DUMP_CHANNEL_ID", "0"))


app = Client(
    "recordbot",
    api_id=API_ID,
    api_hash=API_HASH,
    bot_token=BOT_TOKEN
)

approved_users = {PERMANENT_ADMIN}
active_processes = {}
last_recording = {}


# ---------------- HELPERS ----------------

def time_to_seconds(t):
    parts = list(map(int, t.split(":")))

    if len(parts) == 3:
        h, m, s = parts
    elif len(parts) == 2:
        h, m, s = 0, parts[0], parts[1]
    else:
        h, m, s = 0, 0, parts[0]

    return h * 3600 + m * 60 + s


def readable_size(size):
    for unit in ["B", "KB", "MB", "GB"]:
        if size < 1024:
            return f"{size:.2f} {unit}"
        size /= 1024

    return f"{size:.2f} TB"


# ---------------- UPLOAD ----------------

async def upload_video(chat_id, filepath):
    try:
        duration = float(
            subprocess.check_output([
                "ffprobe",
                "-v", "error",
                "-show_entries", "format=duration",
                "-of", "default=noprint_wrappers=1:nokey=1",
                filepath
            ]).decode().strip()
        )
    except Exception:
        duration = 0

    size = os.path.getsize(filepath)

    caption = (
        f"📁 <b>File:</b> {os.path.basename(filepath)}\n"
        f"⏱ <b>Duration:</b> "
        f"{str(datetime.timedelta(seconds=int(duration)))}\n"
        f"📦 <b>Size:</b> {readable_size(size)}"
    )

    try:
        await app.send_video(
            chat_id,
            filepath,
            caption=caption,
            supports_streaming=True
        )

        if DUMP_CHANNEL_ID != 0:
            await app.send_video(
                DUMP_CHANNEL_ID,
                filepath,
                caption=caption,
                supports_streaming=True
            )

    except FloodWait as e:
        await asyncio.sleep(e.value)
        await upload_video(chat_id, filepath)

    finally:
        if os.path.exists(filepath):
            os.remove(filepath)


# ---------------- RECORD ----------------

async def record_stream(chat_id, url, duration_str, title, msg: Message):
    duration = time_to_seconds(duration_str)

    start = datetime.datetime.now()

    filename = (
        f"{title.replace(' ', '_')}_"
        f"{start.strftime('%Y%m%d_%H%M%S')}_"
        f"{duration}s.mp4"
    )

    cmd = [
        "ffmpeg",
        "-y",
        "-i", url,
        "-t", str(duration),
        "-c:v", "libx264",
        "-preset", "veryfast",
        "-c:a", "aac",
        "-b:a", "128k",
        filename
    ]

    process = subprocess.Popen(
        cmd,
        stderr=subprocess.PIPE
    )

    active_processes[chat_id] = process

    start_ts = datetime.datetime.now().timestamp()

    while process.poll() is None:
        elapsed = int(
            datetime.datetime.now().timestamp() - start_ts
        )

        percent = min(100, elapsed * 100 / duration)

        bar = (
            "█" * int(percent // 10)
            + "░" * (10 - int(percent // 10))
        )

        try:
            await msg.edit(
                f"🎥 <b>{title}</b>\n"
                f"📊 {percent:.1f}% [{bar}]\n"
                f"⏱ {elapsed}/{duration}s"
            )
        except Exception:
            pass

        await asyncio.sleep(5)

    active_processes.pop(chat_id, None)

    await app.send_message(chat_id, "📤 Uploading...")

    last_recording[chat_id] = filename

    await upload_video(chat_id, filename)

    await app.send_message(chat_id, "✅ Upload completed")


# ---------------- COMMANDS ----------------

@app.on_message(filters.command("start"))
async def start(_, m: Message):
    await m.reply(
        "🤖 IPTV Recorder Bot\n\n"
        "/record <url> <duration> <title>\n"
        "Example:\n"
        "/record http://test.m3u8 00:05:00 Sony_HD"
    )


@app.on_message(filters.command("help"))
async def help_cmd(_, m: Message):
    await m.reply(
        "/start\n"
        "/help\n"
        "/record <url> <duration> <title>\n"
        "/cancel\n"
        "/status\n"
        "/addadmin <user_id>"
    )


@app.on_message(filters.command("record"))
async def record(_, m: Message):
    if not m.from_user or m.from_user.id not in approved_users:
        return await m.reply("🚫 Not authorized")

    try:
        _, url, dur, title = m.text.split(" ", 3)
    except Exception:
        return await m.reply(
            "❌ Usage: /record <url> <duration> <title>"
        )

    msg = await m.reply("🎬 Recording started...")

    asyncio.create_task(
        record_stream(m.chat.id, url, dur, title, msg)
    )


@app.on_message(filters.command("cancel"))
async def cancel(_, m: Message):
    p = active_processes.get(m.chat.id)

    if p:
        p.terminate()
        active_processes.pop(m.chat.id, None)

        await m.reply("🛑 Recording cancelled")
    else:
        await m.reply("No active recording")


@app.on_message(filters.command("status"))
async def status(_, m: Message):
    await m.reply(
        f"Recording Active: "
        f"{'Yes' if m.chat.id in active_processes else 'No'}"
    )


@app.on_message(filters.command("addadmin"))
async def addadmin(_, m: Message):
    if not m.from_user or m.from_user.id != PERMANENT_ADMIN:
        return

    try:
        uid = int(m.text.split(" ")[1])

        approved_users.add(uid)

        await m.reply(f"✅ Added {uid}")

    except Exception:
        await m.reply("❌ /addadmin <user_id>")


# ---------------- RUN ----------------

print("🤖 Pyrogram IPTV Recorder Bot Running")

app.run()
