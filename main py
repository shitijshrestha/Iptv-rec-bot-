    )


@client.on(events.NewMessage(pattern=r"^/help$"))
async def help_handler(event):
    await event.reply(
        "<b>🎬 Recording Bot Help</b>\n\n"
        "<b>Start recording:</b>\n"
        '<code>/record STREAM_URL "Show Name" 01:00:00</code>\n\n'
        "<b>Manual split example:</b>\n"
        '<code>/record STREAM_URL "Show Name" 02:00:00 --split 00:30:00</code>\n\n'
        "<b>Other commands:</b>\n"
        "<code>/tasks</code> - Show running task\n"
        "<code>/stop</code> - Stop your recording\n"
        "<code>/help</code> - Show help\n\n"
        "Automatic splitting is enabled for large files."
    )


@client.on(events.NewMessage(pattern=r"^/record(?:\s|$)"))
async def record_handler(event):
    if not is_admin(event.sender_id):
        return await event.reply("⛔ You are not authorized.")

    if event.sender_id in recording_tasks:
        return await event.reply(
            "⚠️ You already have an active recording. Use /stop first."
        )

    raw = event.raw_text.strip()

    # Expected:
    # /record URL "Title" 01:00:00
    # /record URL "Title" 02:00:00 --split 00:30:00

    match = re.match(
        r'^/record\s+(\S+)\s+"([^"]+)"\s+(\S+)'
        r'(?:\s+--split\s+(\S+))?\s*$',
        raw
    )

    if not match:
        return await event.reply(
            "❌ Invalid format.\n\n"
            '<code>/record STREAM_URL "Show Name" 01:00:00</code>\n\n'
            "Manual split:\n"
            '<code>/record STREAM_URL "Show Name" 02:00:00 --split 00:30:00</code>'
        )

    url, title, duration_text, split_text = match.groups()

    try:
        duration = parse_time(duration_text)

        if duration <= 0:
            raise ValueError("Duration must be greater than zero")

        manual_split = (
            parse_time(split_text) if split_text else None
        )

        if manual_split is not None and manual_split <= 0:
            raise ValueError("Split duration must be greater than zero")

    except ValueError as error:
        return await event.reply(f"❌ {html.escape(str(error))}")

    task = asyncio.create_task(
        run_recording(
            event,
            url,
            title,
            duration,
            manual_split
        )
    )

    recording_tasks[event.sender_id] = task

    await event.reply(
        "✅ <b>Recording task started.</b>\n"
        f"Title: <b>{html.escape(title)}</b>\n"
        f"Duration: <b>{format_time(duration)}</b>"
    )


@client.on(events.NewMessage(pattern=r"^/tasks$"))
async def tasks_handler(event):
    if not is_admin(event.sender_id):
        return await event.reply("⛔ You are not authorized.")

    if not recording_tasks:
        return await event.reply("No active recording tasks.")

    lines = ["<b>📋 Active Tasks</b>\n"]

    for user_id, task in recording_tasks.items():
        status = "Running" if not task.done() else "Finished"
        lines.append(f"• <code>{user_id}</code> - {status}")

    await event.reply("\n".join(lines))


@client.on(events.NewMessage(pattern=r"^/stop$"))
async def stop_handler(event):
    if not is_admin(event.sender_id):
        return await event.reply("⛔ You are not authorized.")

    task_id = event.sender_id
    task = recording_tasks.get(task_id)

    if not task:
        return await event.reply("No active recording to stop.")

    process = active_processes.get(task_id)

    if process and process.returncode is None:
        try:
            process.kill()
        except ProcessLookupError:
            pass

    task.cancel()

    await event.reply("🛑 Stop request sent.")


