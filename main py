# RECORDING SYSTEM
# ==================================================

async def record_stream(
    chat_id,
    task_id,
    url,
    title,
    duration_str=None,
    split_duration_str=None
):

    duration = time_to_seconds(duration_str)
    split_seconds = time_to_seconds(split_duration_str)

    if duration_str and (duration is None or duration <= 0):
        await safe_send(chat_id, "❌ Invalid recording duration.")
        return

    if split_duration_str and (
        split_seconds is None or split_seconds <= 0
    ):
        await safe_send(chat_id, "❌ Invalid split interval.")
        return

    safe_title = sanitize_filename(title)
    base = f"{safe_title}_{task_id}"

    start_msg = await client.send_message(
        chat_id,
        f"🎬 <b>New Recording</b>\n\n"
        f"📺 Title: {html.escape(title)}\n"
        f"⏱ Duration: {format_duration(duration) if duration else 'Unlimited'}\n"
        f"✂️ Manual Split: {'ON' if split_seconds else 'OFF'}\n"
        f"📦 Auto Split: {AUTO_SPLIT_THRESHOLD}\n"
        f"🆔 Task ID: <code>{task_id}</code>\n\n"
        f"🔴 <b>Recording Started...</b>",
        parse_mode="html"
    )

    command = [
        "ffmpeg",
        "-hide_banner",
        "-y",
        "-user_agent", "Mozilla/5.0",
        "-reconnect", "1",
        "-reconnect_streamed", "1",
        "-reconnect_delay_max", "5",
        "-i", url,
        "-map", "0",
        "-c", "copy"
    ]

    if duration:
        command.extend(["-t", str(duration)])

    if split_seconds:
        command.extend([
            "-f", "segment",
            "-segment_time", str(split_seconds),
            "-reset_timestamps", "1",
            "-segment_format", "mp4",
            f"{base}_part_%03d.mp4"
        ])
    else:
        command.append(f"{base}.mp4")

    try:
        process = await asyncio.create_subprocess_exec(
            *command,
            stdout=asyncio.subprocess.DEVNULL,
            stderr=asyncio.subprocess.DEVNULL
        )

    except Exception as error:
        await safe_send(
            chat_id,
            f"❌ FFmpeg start failed: {html.escape(str(error))}"
        )
        return

    active_processes[task_id] = process

    start_time = time.time()
    last_update = 0

    try:
        while process.returncode is None:

            await asyncio.sleep(2)

            elapsed = int(time.time() - start_time)

            if process.returncode is not None:
                break

            if time.time() - last_update >= 10:

                if split_seconds:
                    files = glob.glob(f"{base}_part_*.mp4")
                    current_size = sum(
                        os.path.getsize(f)
                        for f in files if os.path.exists(f)
                    )
                else:
                    current_file = f"{base}.mp4"
                    current_size = (
                        os.path.getsize(current_file)
                        if os.path.exists(current_file)
                        else 0
                    )

                progress = (
                    f"🎬 <b>{html.escape(title)}</b>\n\n"
                    f"🔴 <b>Recording...</b>\n"
                    f"⏱ Elapsed: {format_duration(elapsed)}\n"
                    f"📦 Size: {readable_size(current_size)}\n"
                    f"🆔 Task: <code>{task_id}</code>"
                )

                if duration:
                    percent = min(100, elapsed / duration * 100)
                    progress += f"\n📊 Progress: {percent:.1f}%"

                try:
                    await start_msg.edit(progress, parse_mode="html")
                except Exception:
                    pass

                last_update = time.time()

        return_code = await process.wait()

    except asyncio.CancelledError:
        if process.returncode is None:
            process.terminate()

            try:
                await asyncio.wait_for(process.wait(), timeout=10)
            except asyncio.TimeoutError:
                process.kill()
                await process.wait()

        await safe_send(chat_id, "⏹️ Recording cancelled.")
        raise

    finally:
        active_processes.pop(task_id, None)
        recording_tasks.pop(task_id, None)

    if return_code != 0:
        await safe_send(
            chat_id,
            "❌ FFmpeg recording failed. Check the source URL and stream."
        )
        return

    await safe_send(
        chat_id,
        "✅ <b>Recording Complete!</b>\n📤 Processing files..."
    )

    if split_seconds:

        files = sorted(glob.glob(f"{base}_part_*.mp4"))
        total_parts = len(files)

        for index, filepath in enumerate(files, 1):
            success = await upload_file(
                chat_id,
                filepath,
                title,
                index,
                total_parts
            )

            if not success:
                break

    else:
        await handle_recorded_file(
            chat_id,
            f"{base}.mp4",
            title
        )

    try:
        await start_msg.delete()
    except Exception:
        pass


