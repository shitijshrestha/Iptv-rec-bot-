def get_env(name, required=True):
    value = os.getenv(name)
    if required and not value:
        raise ValueError(f"Missing environment variable: {name}")
    return value

API_ID = int(get_env("API_ID"))
API_HASH = get_env("API_HASH")
BOT_TOKEN = get_env("BOT_TOKEN", False)
DUMP_CHANNEL_ID = int(get_env("DUMP_CHANNEL_ID"))

ADMINS_STR = os.getenv("PERMANENT_ADMINS", "")
PERMANENT_ADMINS = {
    int(x) for x in re.split(r"[\s,]+", ADMINS_STR.strip()) if x
}

# AUTO SPLIT
AUTO_SPLIT_ENABLED = True
AUTO_SPLIT_THRESHOLD = "1.95GB"
AUTO_SPLIT_SIZE_BYTES = int(1.95 * 1024**3)

# Safety margin for variable video bitrate
SPLIT_SAFETY_FACTOR = 0.85

# Upload settings
UPLOAD_RETRIES = 3
MIN_FILE_SIZE = 1000

# ==================================================
# INITIALIZATION
# ==================================================

client = TelegramClient("recordbot", API_ID, API_HASH)

