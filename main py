def sanitize_filename(text):
    name = re.sub(r'[\\/*?:"<>|]', "", text)
    name = re.sub(r"\s+", "_", name.strip())
    return name[:100] or "Recording"


def readable_size(size):
    size = float(size)

    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if size < 1024:
            return f"{size:.2f} {unit}"
        size /= 1024

    return f"{size:.2f} PB"


def time_to_seconds(value):
    if not value:
        return None

    try:
        parts = [int(x) for x in value.split(":")]

        if len(parts) == 1:
            return parts[0]

        if len(parts) == 2:
            return parts[0] * 60 + parts[1]

        if len(parts) == 3:
            return parts[0] * 3600 + parts[1] * 60 + parts[2]

        return None

    except ValueError:
        return None


def format_duration(seconds):
    return str(datetime.timedelta(seconds=int(seconds)))


async def get_video_metadata(filepath):
    try:
        process = await asyncio.create_subprocess_exec(
            "ffprobe",
            "-v", "error",
            "-show_entries",
            "format=duration,bit_rate",
            "-show_entries",
            "stream=width,height,duration,bit_rate",
            "-of", "json",
            filepath,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )

        stdout, _ = await process.communicate()

        if process.returncode != 0:
            raise RuntimeError("FFprobe failed")

        data = json.loads(stdout.decode())

        streams = data.get("streams", [])
        video = next(
            (s for s in streams if s.get("width") and s.get("height")),
            {}
        )

        fmt = data.get("format", {})

        duration = float(
            video.get("duration") or fmt.get("duration") or 0
        )

        bitrate = int(
            video.get("bit_rate") or fmt.get("bit_rate") or 0
        )

        width = int(video.get("width", 1280))
        height = int(video.get("height", 720))

        return duration, width, height, bitrate

    except Exception as error:
        print(f"Metadata error: {error}")
        return 0, 1280, 720, 0


async def generate_thumbnail(filepath, duration):
    thumb = filepath + ".jpg"

    try:
        process = await asyncio.create_subprocess_exec(
            "ffmpeg",
            "-y",
            "-ss", str(max(0, duration * 0.1)),
            "-i", filepath,
            "-frames:v", "1",
            "-q:v", "5",
            thumb,
            stdout=asyncio.subprocess.DEVNULL,
            stderr=asyncio.subprocess.DEVNULL
        )

        await process.wait()

        if process.returncode == 0 and os.path.exists(thumb):
            return thumb

    except Exception as error:
        print(f"Thumbnail error: {error}")

    return None


def upload_progress(current, total):
    if total:
        percent = current / total * 100
        print(
            f"UPLOAD: {readable_size(current)} / "
            f"{readable_size(total)} ({percent:.1f}%)"
        )


async def safe_send(chat_id, message):
    try:
        await client.send_message(
            chat_id,
            message,
            parse_mode="html"
        )
    except Exception as error:
        print(f"Message error: {error}")


# ==================================================
# UPLOAD SYSTEM
# ==================================================

async def upload_file(
    chat_id,
    filepath,
    title,
    part_num=None,
    total_parts=None
):
    thumb = None

    try:
        if not os.path.exists(filepath):
            raise FileNotFoundError(filepath)

        file_size = os.path.getsize(filepath)

        if file_size < MIN_FILE_SIZE:
            raise ValueError("File is empty or corrupted")

        duration, width, height, _ = await get_video_metadata(filepath)

        if part_num and total_parts:
            final_title = f"{title} (Part {part_num}/{total_parts})"
        elif part_num:
            final_title = f"{title} (Part {part_num})"
        else:
            final_title = title

        caption = (
            f"🎬 <b>{html.escape(final_title)}</b>\n\n"
            f"✨ <i>Recording successfully captured.</i>\n\n"
            f"<b>Video Details</b>\n"
            f"📁 File: <code>{html.escape(os.path.basename(filepath))}</code>\n"
            f"⏱ Duration: <code>{format_duration(duration)}</code>\n"
            f"📦 Size: <code>{readable_size(file_size)}</code>\n"
            f"🖥 Resolution: <code>{width}x{height}</code>"
        )

        thumb = await generate_thumbnail(filepath, duration) if duration else None

        for attempt in range(UPLOAD_RETRIES):
            try:
                print(f"UPLOAD START: {filepath}")

                dump = await client.send_file(
                    DUMP_CHANNEL_ID,
                    filepath,
                    caption=caption,
                    parse_mode="html",
                    thumb=thumb,
                    supports_streaming=True,
                    attributes=[
                        DocumentAttributeVideo(
                            duration=max(1, int(duration)),
                            w=width,
                            h=height,
                            supports_streaming=True
                        )
                    ],
                    progress_callback=upload_progress
                )

                await client.send_file(
                    chat_id,
                    file=dump.media,
                    caption=caption,
                    parse_mode="html"
                )

                print(f"UPLOAD SUCCESS: {filepath}")
                return True

            except FloodWaitError as error:
                wait = error.seconds + 5
                print(f"FloodWait: {wait}s")
                await asyncio.sleep(wait)

            except Exception as error:
                print(f"Upload attempt {attempt + 1}: {error}")

                if attempt == UPLOAD_RETRIES - 1:
                    raise

                await asyncio.sleep(5)

    except Exception as error:
        print(f"UPLOAD FAILED: {error}")

        await safe_send(
            chat_id,
            f"❌ <b>Upload Failed</b>\n"
            f"<code>{html.escape(str(error))}</code>"
        )

        return False

    finally:
        if thumb and os.path.exists(thumb):
            os.remove(thumb)

        if os.path.exists(filepath):
            os.remove(filepath)

    return False


# ==================================================
# AUTOMATIC SIZE SPLITTING
# ==================================================

async def split_file_by_size(chat_id, original_path, title):

    if not os.path.exists(original_path):
        return

    total_duration, _, _, bitrate = await get_video_metadata(
        original_path
    )

    file_size = os.path.getsize(original_path)

    if total_duration <= 0:
        await safe_send(chat_id, "❌ Cannot determine video duration.")
        return

    if bitrate <= 0:
        bitrate = int(file_size * 8 / total_duration)

    if bitrate <= 0:
        await safe_send(chat_id, "❌ Cannot determine video bitrate.")
        return

    await safe_send(
        chat_id,
        f"✂️ <b>Automatic Splitting Started</b>\n\n"
        f"📦 Original: {readable_size(file_size)}\n"
        f"🎯 Target: {AUTO_SPLIT_THRESHOLD} per part"
    )

    current_position = 0
    part_number = 1
    parts = []

    while current_position < total_duration:

        remaining = total_duration - current_position

        estimated_duration = max(
            1,
            int(
                AUTO_SPLIT_SIZE_BYTES
                * 8
                * SPLIT_SAFETY_FACTOR
                / bitrate
            )
        )

        chunk_duration = min(estimated_duration, remaining)

        while True:

            part_path = (
                f"{original_path}_part_{part_number:03d}.mp4"
            )

            command = [
                "ffmpeg",
                "-y",
                "-ss", str(current_position),
                "-i", original_path,
                "-t", str(chunk_duration),
                "-map", "0",
                "-c", "copy",
                "-avoid_negative_ts", "make_zero",
                "-movflags", "+faststart",
                part_path
            ]

            process = await asyncio.create_subprocess_exec(
                *command,
                stdout=asyncio.subprocess.DEVNULL,
                stderr=asyncio.subprocess.PIPE
            )

            _, stderr = await process.communicate()

            if (
                process.returncode != 0
                or not os.path.exists(part_path)
                or os.path.getsize(part_path) < MIN_FILE_SIZE
            ):
                print(stderr.decode(errors="replace")[-2000:])

                if os.path.exists(part_path):
                    os.remove(part_path)

                await safe_send(chat_id, "❌ FFmpeg splitting failed.")
                for old_part in parts:
                    if os.path.exists(old_part):
                        os.remove(old_part)
                return

            actual_size = os.path.getsize(part_path)

            # Retry an oversized part using a shorter duration.
            if actual_size > AUTO_SPLIT_SIZE_BYTES:
                os.remove(part_path)

                if chunk_duration <= 1:
                    await safe_send(
                        chat_id,
                        "❌ Could not create a part within the size limit."
                    )
                    for old_part in parts:
                        if os.path.exists(old_part):
                            os.remove(old_part)
                    return

                chunk_duration = max(1, chunk_duration // 2)
                continue

            break

        part_duration, _, _, _ = await get_video_metadata(part_path)

        if part_duration <= 0:
            os.remove(part_path)
            await safe_send(chat_id, "❌ Cannot read split part duration.")
            return

        parts.append(part_path)

        print(
            f"PART {part_number}: {readable_size(actual_size)} "
            f"| {format_duration(part_duration)}"
        )

        current_position += part_duration
        part_number += 1

    total_parts = len(parts)

    await safe_send(
        chat_id,
        f"✅ <b>Splitting Complete!</b>\n"
        f"📦 Total Parts: {total_parts}\n"
        f"🚀 Starting uploads..."
    )

    for index, part in enumerate(parts, 1):
        success = await upload_file(
            chat_id,
            part,
            title,
            index,
            total_parts
        )

        if not success:
            await safe_send(
                chat_id,
                f"⚠️ Part {index} upload failed. Remaining uploads stopped."
            )
            break

    if os.path.exists(original_path):
        os.remove(original_path)


async def handle_recorded_file(chat_id, filepath, title):

    if not os.path.exists(filepath):
        await safe_send(chat_id, "❌ Recording file not found.")
        return

    size = os.path.getsize(filepath)

    if size < MIN_FILE_SIZE:
        await safe_send(chat_id, "❌ Recording file is empty.")
        os.remove(filepath)
        return

    if AUTO_SPLIT_ENABLED and size > AUTO_SPLIT_SIZE_BYTES:
        await split_file_by_size(chat_id, filepath, title)
    else:
        await upload_file(chat_id, filepath, title)


