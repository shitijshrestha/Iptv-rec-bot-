@client.on(events.NewMessage(pattern=r"^/start$"))
async def start_cmd(event):

    await event.reply(
        "👋 <b>IPTV Recording Bot</b>\n\n"
        "Use /help to see available commands.",
        parse_mode="html"
    )


@client.on(events.NewMessage(pattern=r"^/help$"))
async def help_cmd(event):

    await event.reply(
        "<b>Recording Commands</b>\n\n"
        "<code>/record URL \"Title\" 01:00:00</code>\n\n"
        "Manual split example:\n"
        "<code>/record URL \"Title\" 01:00:00 --split 00:10:00</code>\n\n"
        "Unlimited recording:\n"
        "<code>/record URL \"Title\"</code>\n\n"
        "Other commands:\n"
        "/tasks - Active tasks\n"
        "/stop TASK_ID - Stop recording\n\n"
        f"📦 Auto Split: {AUTO_SPLIT_THRESHOLD}",
        parse_mode="html"
    )


@client.on(events.NewMessage(pattern=r"^/record(?:\s|$)"))
async def record_cmd(event):

    if event.sender_id not in approved_users:
        return await event.reply("🚫 Access Denied!")

    try:
        args = shlex.split(event.raw_text)

        if len(args) < 3:
            raise ValueError("Not enough arguments.")

        url = args[1]

        if not url.startswith(("http://", "https://")):
            raise ValueError("Invalid stream URL.")

        split_duration = None

        if "--split" in args:
            split_index = args.index("--split")

            if split_index + 1 >= len(args):
                raise ValueError("Missing split duration after --split")

            split_duration = args[split_index + 1]

            if time_to_seconds(split_duration) is None:
                raise ValueError("Invalid split duration.")

            del args[split_index:split_index + 2]
