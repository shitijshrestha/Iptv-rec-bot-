load_dotenv()

def get_env(name, required=True, default=None):
    value = os.getenv(name, default)
    if required and not value:
        raise ValueError(f"Missing environment variable: {name}")
    return value


API_ID = int(get_env("API_ID"))
API_HASH = get_env("API_HASH")
BOT_TOKEN = get_env("BOT_TOKEN")
DUMP_CHANNEL_ID = int(get_env("DUMP_CHANNEL_ID"))

PERMANENT_ADMINS = {
    int(x.strip())
    for x in get_env("PERMANENT_ADMINS", False, "").split(",")
    if x.strip()
}

MAX_FILE_SIZE = int(1.95 * 1024 * 1024 * 1024)
MIN_FILE_SIZE = 1000
UPLOAD_RETRIES = 3
RECORD_DIR = "recordings"

FFMPEG = get_env("FFMPEG_PATH", False, "ffmpeg")
FFPROBE = get_env("FFPROBE_PATH", False, "ffprobe")

os.makedirs(RECORD_DIR, exist_ok=True)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s"
)
logger = logging.getLogger(__name__)

client = TelegramClient("recording_bot", API_ID, API_HASH)

recording_tasks = {}
active_processes = {}


# =========================================================
# HELPERS
# =========================================================

def is_admin(user_id):
    return user_id in PERMANENT_ADMINS


def safe_filename(name):
    name = re.sub(r'[\\/:*?"<>|]+', "_", name)
    name = re.sub(r"\s+", " ", name).strip()
    return name[:100] or "Recording"


def readable_size(size):
    size = float(size)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size < 1024:
            return f"{size:.2f} {unit}"
        size /= 1024
    return f"{size:.2f} PB"


def parse_time(value):
    """
    Supports:
    3600
    01:00
    01:00:00
    """
    value = value.strip()

    if value.isdigit():
        return int(value)

    parts = value.split(":")
    if not all(part.isdigit() for part in parts):
        raise ValueError("Invalid time format")

    parts = [int(part) for part in parts]

    if len(parts) == 2:
        minutes, seconds = parts
        return minutes * 60 + seconds

    if len(parts) == 3:
        hours, minutes, seconds = parts
        return hours * 3600 + minutes * 60 + seconds

    raise ValueError("Use HH:MM:SS or seconds")


def format_time(seconds):
    seconds = max(0, int(seconds))
    return str(datetime.timedelta(seconds=seconds))


async def run_command(*args):
    process = await asyncio.create_subprocess_exec(
        *args,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await process.communicate()

    if process.returncode != 0:
        raise RuntimeError(
            stderr.decode(errors="ignore")[-3000:]
        )

    return stdout.decode(errors="ignore")


async def get_duration(path):
    output = await run_command(
        FFPROBE,
        "-v", "error",
        "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1",
        path
    )

    try:
        return float(output.strip())
    except (ValueError, TypeError):
        return 0.0


async def get_bitrate(path):
    output = await run_command(
        FFPROBE,
        "-v", "error",
        "-show_entries", "format=bit_rate",
        "-of", "default=noprint_wrappers=1:nokey=1",
        path
    )

    try:
        return int(output.strip())
    except (ValueError, TypeError):
        return 0


async def make_thumbnail(video_path):
    thumb_path = video_path + ".jpg"

    try:
        await run_command(
            FFMPEG,
            "-y",
            "-ss", "00:00:05",
            "-i", video_path,
            "-frames:v", "1",
            "-vf", "scale=320:-1",
            thumb_path
        )

        if os.path.exists(thumb_path):
            return thumb_path

    except Exception as error:
        logger.warning("Thumbnail creation failed: %s", error)

    return None


def video_attributes(duration):
    return [
        DocumentAttributeVideo(
            duration=max(1, int(duration)),
            w=1280,
            h=720,
            supports_streaming=True
        )
    ]


async def safe_edit(message, text):
    try:
        await message.edit(text)
    except Exception:
        pass


# =========================================================
# PROGRESS
# =========================================================

async def upload_progress(current, total, status_message, started):
    if not total:
        return

    now = time.time()

    if current != total and now - upload_progress.last_update < 3:
        return

    upload_progress.last_update = now

    percent = current * 100 / total
    elapsed = max(1, now - started)
    speed = current / elapsed
    remaining = (total - current) / speed if speed else 0

    text = (
        "📤 <b>Uploading...</b>\n\n"
        f"Progress: <b>{percent:.1f}%</b>\n"
        f"Uploaded: {readable_size(current)} / {readable_size(total)}\n"
        f"Speed: {readable_size(speed)}/s\n"
        f"ETA: {format_time(remaining)}"
    )

    await safe_edit(status_message, text)


upload_progress.last_update = 0


# =========================================================
# RECORDING
# =========================================================

async def record_stream(url, output_path, duration, task_id, status_message):
    command = [
        FFMPEG,
        "-y",
        "-hide_banner",
        "-loglevel", "error",
        "-i", url,
        "-map", "0",
        "-c", "copy",
        "-t", str(duration),
        "-movflags", "+faststart",
        output_path
    ]

    process = await asyncio.create_subprocess_exec(
        *command,
        stdout=asyncio.subprocess.DEVNULL,
        stderr=asyncio.subprocess.PIPE
    )

    active_processes[task_id] = process
    started = time.time()

    try:
        while process.returncode is None:
            if process.returncode is not None:
                break

            await asyncio.sleep(5)

            elapsed = int(time.time() - started)
            await safe_edit(
                status_message,
                "🔴 <b>Recording in progress</b>\n\n"
                f"Elapsed: <b>{format_time(elapsed)}</b>\n"
                f"Target: <b>{format_time(duration)}</b>\n"
                f"File: <code>{html.escape(os.path.basename(output_path))}</code>"
            )

            if process.returncode is not None:
                break

        await process.wait()

        if process.returncode != 0:
            error = await process.stderr.read()
            raise RuntimeError(
                error.decode(errors="ignore")[-2500:]
            )

        if not os.path.exists(output_path):
            raise RuntimeError("Recording file was not created")

        if os.path.getsize(output_path) < MIN_FILE_SIZE:
            raise RuntimeError("Recording file is empty or too small")

    except asyncio.CancelledError:
        if process.returncode is None:
            process.kill()
            await process.wait()
        raise

    finally:
        active_processes.pop(task_id, None)


# =========================================================
# FILE SPLITTING
# =========================================================

async def split_file_by_duration(input_path, segment_seconds, base_name):
    pattern = os.path.join(
        RECORD_DIR,
        f"{base_name}_part_%03d.mp4"
    )

    await run_command(
        FFMPEG,
        "-y",
        "-hide_banner",
        "-loglevel", "error",
        "-i", input_path,
        "-map", "0",
        "-c", "copy",
        "-f", "segment",
        "-segment_time", str(max(60, int(segment_seconds))),
        "-reset_timestamps", "1",
        "-segment_format", "mp4",
        pattern
    )

    return sorted(
        glob.glob(
            os.path.join(RECORD_DIR, f"{base_name}_part_*.mp4")
        )
    )


async def prepare_upload_files(input_path, title, manual_split=None):
    file_size = os.path.getsize(input_path)
    duration = await get_duration(input_path)

    if manual_split:
        segment_seconds = manual_split
    elif file_size > MAX_FILE_SIZE:
        bitrate = await get_bitrate(input_path)

        if bitrate > 0:
            segment_seconds = int(
                MAX_FILE_SIZE * 8 / bitrate * 0.85
            )
        elif duration > 0:
            segment_seconds = int(
                duration * MAX_FILE_SIZE / file_size * 0.80
            )
        else:
            raise RuntimeError("Unable to calculate automatic split size")

        segment_seconds = max(60, segment_seconds)
    else:
        return [input_path]

    base_name = safe_filename(title)
    parts = await split_file_by_duration(
        input_path,
        segment_seconds,
        base_name
    )

    if not parts:
        raise RuntimeError("FFmpeg could not split the recording")

    # Check part sizes and split oversized parts again.
    final_parts = []

    for part in parts:
        part_size = os.path.getsize(part)

        if part_size <= MAX_FILE_SIZE:
            final_parts.append(part)
            continue

        part_duration = await get_duration(part)

        if part_duration <= 0:
            raise RuntimeError(
                f"Could not read duration of {os.path.basename(part)}"
            )

        smaller_seconds = max(
            60,
            int(part_duration * MAX_FILE_SIZE / part_size * 0.75)
        )

        sub_base = safe_filename(
            os.path.basename(part).replace(".mp4", "_sub")
        )

        sub_parts = await split_file_by_duration(
            part,
            smaller_seconds,
            sub_base
        )

        if not sub_parts:
            raise RuntimeError("Second split attempt failed")

        for sub_part in sub_parts:
            if os.path.getsize(sub_part) > MAX_FILE_SIZE:
                raise RuntimeError(
                    "A split part is still larger than the upload limit"
                )
            final_parts.append(sub_part)

        try:
            os.remove(part)
        except OSError:
            pass

    return final_parts


# =========================================================
# UPLOAD
# =========================================================

async def upload_one_file(path, title, part_number, total_parts, chat_id, status_message):
    duration = await get_duration(path)
    thumb_path = await make_thumbnail(path)

    if total_parts > 1:
        caption = (
            f"<b>{html.escape(title)}</b>\n"
            f"📁 Part {part_number}/{total_parts}\n"
            "Powered by @ShitijRips"
        )
    else:
        caption = (
            f"<b>{html.escape(title)}</b>\n"
            "Powered by @ShitijRips"
        )

    last_error = None

    for attempt in range(1, UPLOAD_RETRIES + 1):
        try:
            upload_progress.last_update = 0
            started = time.time()

            await safe_edit(
                status_message,
                f"📤 <b>Uploading part {part_number}/{total_parts}</b>\n"
                f"Size: {readable_size(os.path.getsize(path))}\n"
                f"Attempt: {attempt}/{UPLOAD_RETRIES}"
            )

            sent = await client.send_file(
                DUMP_CHANNEL_ID,
                path,
                caption=caption,
                thumb=thumb_path,
                supports_streaming=True,
                attributes=video_attributes(duration),
                progress_callback=lambda current, total: asyncio.create_task(
                    upload_progress(
                        current,
                        total,
                        status_message,
                        started
                    )
                )
            )

            # Copy the uploaded media from the dump channel to the user.
            dump_message = sent[0] if isinstance(sent, list) else sent

            await client.send_file(
                chat_id,
                dump_message.media,
                caption=caption,
                supports_streaming=True,
                attributes=video_attributes(duration)
            )

            return

        except FloodWaitError as error:
            last_error = error
            await asyncio.sleep(error.seconds + 2)

        except Exception as error:
            last_error = error
            logger.exception("Upload attempt %s failed", attempt)

            if attempt < UPLOAD_RETRIES:
                await asyncio.sleep(5)

    raise RuntimeError(f"Upload failed: {last_error}")

    if thumb_path and os.path.exists(thumb_path):
        os.remove(thumb_path)


# =========================================================
# COMPLETE RECORDING TASK
# =========================================================

async def run_recording(event, url, title, duration, manual_split=None):
    task_id = event.sender_id
    title = safe_filename(title)

    output_path = os.path.join(
        RECORD_DIR,
        f"{title}_{int(time.time())}.mp4"
    )

    status_message = await event.reply(
        "⏳ <b>Preparing recording...</b>"
    )

    try:
        await record_stream(
            url,
            output_path,
            duration,
            task_id,
            status_message
        )

        await safe_edit(
            status_message,
            "✅ <b>Recording completed!</b>\n"
            f"Size: {readable_size(os.path.getsize(output_path))}\n"
            "Preparing upload files..."
        )

        files_to_upload = await prepare_upload_files(
            output_path,
            title,
            manual_split
        )

        total_parts = len(files_to_upload)

        for index, file_path in enumerate(files_to_upload, start=1):
            if task_id not in recording_tasks:
                raise asyncio.CancelledError

            await upload_one_file(
                file_path,
                title,
                index,
                total_parts,
                event.chat_id,
                status_message
            )

            try:
                os.remove(file_path)
            except OSError:
                pass

        await safe_edit(
            status_message,
            "🎉 <b>Recording and upload completed!</b>\n\n"
            f"Title: <b>{html.escape(title)}</b>\n"
            f"Parts uploaded: <b>{total_parts}</b>"
        )

    except asyncio.CancelledError:
        await safe_edit(
            status_message,
            "🛑 <b>Recording cancelled.</b>"
        )

    except Exception as error:
        logger.exception("Recording task failed")
        await safe_edit(
            status_message,
            "❌ <b>Task failed</b>\n\n"
            f"<code>{html.escape(str(error)[-2500:])}</code>"
        )

    finally:
        active_processes.pop(task_id, None)
        recording_tasks.pop(task_id, None)

        for path in glob.glob(os.path.join(RECORD_DIR, "*")):
            try:
                if os.path.isfile(path):
                    os.remove(path)
            except OSError:
                pass


